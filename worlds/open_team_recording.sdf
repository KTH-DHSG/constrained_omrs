<?xml version="1.0"?>
<sdf version="1.9">
  <world name="open_team">
    <physics name="2ms_recording" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.88 0.88 0.88 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <direction>-0.45 0.25 -0.85</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.58 0.61 0.64 1</ambient><diffuse>0.72 0.74 0.76 1</diffuse><specular>0.08 0.08 0.08 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="charging_station">
      <static>true</static>
      <pose>0 -3.15 0 0 0 0</pose>
      <link name="platform">
        <collision name="platform_collision"><pose>0 0 0.015 0 0 0</pose><geometry><box><size>3.25 1.65 0.03</size></box></geometry></collision>
        <visual name="platform_visual"><pose>0 0 0.015 0 0 0</pose><geometry><box><size>3.25 1.65 0.03</size></box></geometry><material><ambient>0.10 0.11 0.13 1</ambient><diffuse>0.18 0.20 0.23 1</diffuse></material></visual>
        <visual name="pad_0"><pose>-1.200 -0.400 0.034 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.008</length></cylinder></geometry><material><ambient>0.08 0.30 0.16 1</ambient><diffuse>0.10 0.55 0.25 1</diffuse><emissive>0.02 0.08 0.03 1</emissive></material></visual>
        <visual name="pad_1"><pose>-0.400 -0.400 0.034 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.008</length></cylinder></geometry><material><ambient>0.08 0.30 0.16 1</ambient><diffuse>0.10 0.55 0.25 1</diffuse><emissive>0.02 0.08 0.03 1</emissive></material></visual>
        <visual name="pad_2"><pose>0.400 -0.400 0.034 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.008</length></cylinder></geometry><material><ambient>0.08 0.30 0.16 1</ambient><diffuse>0.10 0.55 0.25 1</diffuse><emissive>0.02 0.08 0.03 1</emissive></material></visual>
        <visual name="pad_3"><pose>1.200 -0.400 0.034 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.008</length></cylinder></geometry><material><ambient>0.08 0.30 0.16 1</ambient><diffuse>0.10 0.55 0.25 1</diffuse><emissive>0.02 0.08 0.03 1</emissive></material></visual>
        <visual name="pad_4"><pose>1.200 0.400 0.034 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.008</length></cylinder></geometry><material><ambient>0.08 0.30 0.16 1</ambient><diffuse>0.10 0.55 0.25 1</diffuse><emissive>0.02 0.08 0.03 1</emissive></material></visual>
        <visual name="pad_5"><pose>0.400 0.400 0.034 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.008</length></cylinder></geometry><material><ambient>0.08 0.30 0.16 1</ambient><diffuse>0.10 0.55 0.25 1</diffuse><emissive>0.02 0.08 0.03 1</emissive></material></visual>
        <visual name="pad_6"><pose>-0.400 0.400 0.034 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.008</length></cylinder></geometry><material><ambient>0.08 0.30 0.16 1</ambient><diffuse>0.10 0.55 0.25 1</diffuse><emissive>0.02 0.08 0.03 1</emissive></material></visual>
        <visual name="station_label">
          <pose>0 -0.93 0.11 0 0 0</pose>
          <geometry><box><size>1.15 0.10 0.14</size></box></geometry>
          <material><ambient>0.10 0.25 0.35 1</ambient><diffuse>0.12 0.42 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="workspace_post_0"><static>true</static><pose>-2.7 1.7 0 0 0 0</pose><link name="link"><collision name="collision"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.9</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.9</length></cylinder></geometry><material><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link></model>
    <model name="workspace_post_1"><static>true</static><pose>2.7 1.7 0 0 0 0</pose><link name="link"><collision name="collision"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.9</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.9</length></cylinder></geometry><material><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link></model>
    <model name="workspace_post_2"><static>true</static><pose>-2.7 -1.5 0 0 0 0</pose><link name="link"><collision name="collision"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.9</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.9</length></cylinder></geometry><material><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link></model>
    <model name="workspace_post_3"><static>true</static><pose>2.7 -1.5 0 0 0 0</pose><link name="link"><collision name="collision"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.9</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.9</length></cylinder></geometry><material><diffuse>0.32 0.35 0.38 1</diffuse></material></visual></link></model>

    <include>
      <uri>model://omrs_quadrotor</uri>
      <name>drone_0</name>
      <pose>-1.20000 -3.55000 0.16000 0 0 0</pose>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>drone_0</robotNamespace>
        <jointName>rotor_0_joint</jointName>
        <linkName>rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.045</timeConstantUp>
        <timeConstantDown>0.045</timeConstantDown>
        <maxRotVelocity>900.0</maxRotVelocity>
        <motorConstant>8.64197530864e-06</motorConstant>
        <momentConstant>0.018</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>drone_0</robotNamespace>
        <jointName>rotor_1_joint</jointName>
        <linkName>rotor_1</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.045</timeConstantUp>
        <timeConstantDown>0.045</timeConstantDown>
        <maxRotVelocity>900.0</maxRotVelocity>
        <motorConstant>8.64197530864e-06</motorConstant>
        <momentConstant>0.018</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <actuator_number>1</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
